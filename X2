<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FLY YUN - 核心管理系统</title>
    <script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --ios-accent: #007AFF;
            --ios-bg: #F2F2F7;
            --glass: rgba(255, 255, 255, 0.45);
            --radius-max: 35px;
            --admin-purple: #AF52DE;
        }

        body, html {
            margin: 0; padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
            background: #F2F2F7;
            -webkit-font-smoothing: antialiased;
        }

        /* --- iOS 26 动态背影 --- */
        .liquid-bg {
            position: fixed; inset: 0;
            background: linear-gradient(120deg, #e0e7ff 0%, #fdfbfb 100%);
            z-index: -1;
        }

        /* --- 首页：超级登录 UI --- */
        #loginOverlay {
            position: fixed; inset: 0; display: flex; justify-content: center; align-items: center;
            z-index: 10000; backdrop-filter: blur(40px); background: rgba(255,255,255,0.1);
        }
        .spatial-card {
            background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(50px) saturate(200%);
            border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 50px;
            padding: 50px 40px; width: 85%; max-width: 380px; text-align: center;
            box-shadow: 0 40px 100px rgba(0,0,0,0.08);
        }
        .spatial-card h1 { font-size: 38px; font-weight: 900; margin: 0; letter-spacing: -2px; }
        
        .ios-input {
            width: 100%; padding: 18px; border-radius: 20px; border: none;
            background: rgba(255, 255, 255, 0.7); font-size: 18px; font-weight: 600;
            text-align: center; outline: none; margin-top: 30px;
        }
        .btn-main {
            width: 100%; padding: 18px; border-radius: 20px; border: none;
            background: #1d1d1f; color: white; font-weight: 700; margin-top: 20px; cursor: pointer;
        }
        .admin-link { margin-top: 20px; font-size: 12px; color: var(--ios-accent); cursor: pointer; font-weight: 600; }

        /* --- 后台管理面板 --- */
        #adminPanel { display: none; padding: 40px 20px; max-width: 1000px; margin: 0 auto; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        
        /* --- 寻访主界面 --- */
        .app-shell { max-width: 1300px; margin: 0 auto; padding: 20px 20px 120px; display: none; }
        .ios-card {
            background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(20px);
            border-radius: var(--radius-max); padding: 25px; margin-bottom: 25px;
            border: 1px solid rgba(255,255,255,0.8);
        }

        /* 统一表格 */
        .ios-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        .ios-table th { text-align: left; font-size: 12px; color: #8e8e93; padding: 15px; border-bottom: 1px solid rgba(0,0,0,0.05); }
        .ios-table td { padding: 15px; font-size: 14px; border-bottom: 1px solid rgba(0,0,0,0.03); }

        /* 底部 Dock */
        .dock {
            position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%);
            background: rgba(255,255,255,0.8); backdrop-filter: blur(30px);
            padding: 10px 25px; border-radius: 30px; display: flex; gap: 15px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1); z-index: 999;
        }
        .dock-btn { border: none; padding: 12px 20px; border-radius: 18px; font-weight: 700; cursor: pointer; }

        /* 标记 */
        .tag-purple { background: #F5E7FF; color: var(--admin-purple); padding: 4px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; }
    </style>
</head>
<body>

<div class="liquid-bg"></div>

<div id="loginOverlay">
    <div class="spatial-card">
        <h1 id="loginTitle">FLY YUN</h1>
        <p id="loginSub">生成并进入您的存储空间</p>
        <input type="password" id="sysPass" class="ios-input" placeholder="输入访问密码">
        <button class="btn-main" onclick="handleEntry()">解锁空间</button>
        <div class="admin-link" onclick="toggleAdminMode()">切换超级管理员模式</div>
    </div>
</div>

<div id="adminPanel">
    <div class="admin-header">
        <h2 style="font-size: 32px; font-weight: 900; color: var(--admin-purple);">控制中心</h2>
        <button class="dock-btn" style="background:#000; color:#fff;" onclick="location.reload()">退出管理</button>
    </div>
    
    <div class="ios-card">
        <div style="font-weight: 700; margin-bottom: 20px;">📦 全局存储空间概览</div>
        <table class="ios-table">
            <thead>
                <tr>
                    <th>空间 ID (原始密码)</th>
                    <th>候选人数</th>
                    <th>岗位数</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody id="adminTableBody">
                </tbody>
        </table>
    </div>

    <div class="ios-card" style="background: #FFF1F0; border-color: #FFA39E;">
        <div style="font-weight: 700; color: #CF1322;">⚠️ 危险区域</div>
        <p style="font-size: 13px; color: #CF1322;">清除所有浏览器缓存将永久抹除所有用户空间的数据。</p>
        <button class="dock-btn" style="background: #CF1322; color: #fff;" onclick="dangerClearAll()">重置并抹除所有空间</button>
    </div>
</div>

<div class="app-shell" id="app">
    <header style="margin-bottom: 30px;">
        <h2 style="font-size: 30px; font-weight: 900;">FLY YUN</h2>
        <div id="userTag" class="tag-purple"></div>
    </header>

    <div class="ios-card">
        <div style="font-weight: 700; margin-bottom: 15px;">快速录入</div>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px;">
            <input type="text" id="f3" class="ios-input" style="margin:0; padding:12px; font-size:14px;" placeholder="姓名">
            <select id="f5" class="ios-input" style="margin:0; padding:12px; font-size:14px;"><option>正在联系中</option><option>合适</option><option>不合适</option></select>
            <button class="btn-main" style="margin:0; padding:12px;" onclick="quickSave()">存入名单</button>
        </div>
        <p style="font-size: 11px; color: #8e8e93; margin-top: 10px;">* 为保持精简，此处仅展示快捷录入，详细请使用底部菜单</p>
    </div>

    <div class="ios-card">
        <div style="font-weight: 700; margin-bottom: 15px;">当前空间名单</div>
        <div style="overflow-x: auto;">
            <table class="ios-table">
                <thead><tr><th>姓名</th><th>状态</th><th>客户</th><th>资历</th></tr></thead>
                <tbody id="userTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div class="dock" id="userDock" style="display:none">
    <button class="dock-btn" style="background:var(--ios-accent); color:#fff;" onclick="alert('16环节表单弹出')">📝 详细录入</button>
    <button class="dock-btn" style="background:#34C759; color:#fff;" onclick="exportExcel()">📊 导出</button>
    <button class="dock-btn" style="background:#E5E5EA;" onclick="location.reload()">🔒 退出</button>
</div>

<script>
    let mode = "user"; // "user" 或 "admin"
    const MASTER_KEY = "FLY999"; // 这里是你的超级管理员密钥
    let currentDB = "";

    function toggleAdminMode() {
        mode = (mode === "user") ? "admin" : "user";
        const title = document.getElementById('loginTitle');
        const sub = document.getElementById('loginSub');
        if(mode === "admin") {
            title.innerText = "ADMIN";
            title.style.color = "var(--admin-purple)";
            sub.innerText = "请输入超级管理员密钥";
        } else {
            title.innerText = "FLY YUN";
            title.style.color = "#000";
            sub.innerText = "生成并进入您的存储空间";
        }
    }

    function handleEntry() {
        const input = document.getElementById('sysPass').value;
        if(!input) return;

        if(mode === "admin") {
            if(input === MASTER_KEY) {
                showAdminPanel();
            } else {
                alert("超级密钥错误");
            }
        } else {
            currentDB = "FLY_DB_" + btoa(input);
            registerSpace(input); // 记录这个空间
            showUserApp(input);
        }
    }

    // --- 管理员逻辑 ---
    function registerSpace(pass) {
        let registry = JSON.parse(localStorage.getItem("FLY_REGISTRY") || "[]");
        if(!registry.includes(pass)) {
            registry.push(pass);
            localStorage.setItem("FLY_REGISTRY", JSON.stringify(registry));
        }
    }

    function showAdminPanel() {
        document.getElementById('loginOverlay').style.display = 'none';
        document.getElementById('adminPanel').style.display = 'block';
        loadAdminData();
    }

    function loadAdminData() {
        const registry = JSON.parse(localStorage.getItem("FLY_REGISTRY") || "[]");
        const tbody = document.getElementById('adminTableBody');
        tbody.innerHTML = registry.map(pass => {
            const dbKey = "FLY_DB_" + btoa(pass);
            const count = JSON.parse(localStorage.getItem(dbKey) || "[]").length;
            const jobCount = JSON.parse(localStorage.getItem(dbKey + "_jobs") || "[]").length;
            return `
                <tr>
                    <td><span class="tag-purple">${pass}</span></td>
                    <td><b>${count}</b> 人</td>
                    <td>${jobCount} 个</td>
                    <td>
                        <button onclick="deleteSpace('${pass}')" style="color:red; border:none; background:none; cursor:pointer;">删除空间</button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    function deleteSpace(pass) {
        if(confirm(`确定要销毁空间 [${pass}] 吗？数据不可恢复！`)) {
            const dbKey = "FLY_DB_" + btoa(pass);
            localStorage.removeItem(dbKey);
            localStorage.removeItem(dbKey + "_jobs");
            let registry = JSON.parse(localStorage.getItem("FLY_REGISTRY") || "[]");
            registry = registry.filter(p => p !== pass);
            localStorage.setItem("FLY_REGISTRY", JSON.stringify(registry));
            loadAdminData();
        }
    }

    function dangerClearAll() {
        if(confirm("确定抹除浏览器内所有数据？")) {
            localStorage.clear();
            location.reload();
        }
    }

    // --- 用户逻辑 ---
    function showUserApp(pass) {
        document.getElementById('loginOverlay').style.display = 'none';
        document.getElementById('app').style.display = 'block';
        document.getElementById('userDock').style.display = 'flex';
        document.getElementById('userTag').innerText = "空间: " + pass;
        renderUserTable();
    }

    function quickSave() {
        const name = document.getElementById('f3').value;
        const status = document.getElementById('f5').value;
        if(!name) return alert("姓名必填");
        
        let candidates = JSON.parse(localStorage.getItem(currentDB) || "[]");
        candidates.push({ id: Date.now(), f3: name, f5: status, f1: "未分类" });
        localStorage.setItem(currentDB, JSON.stringify(candidates));
        renderUserTable();
        document.getElementById('f3').value = "";
    }

    function renderUserTable() {
        let candidates = JSON.parse(localStorage.getItem(currentDB) || "[]");
        document.getElementById('userTableBody').innerHTML = candidates.map(i => `
            <tr><td><b>${i.f3}</b></td><td>${i.f5}</td><td>${i.f1}</td><td>-</td></tr>
        `).join('');
    }

</script>
</body>
</html>
