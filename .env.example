# Supabase public Data API. Publishable keys are safe in browser code when RLS
# is enabled; never place a secret/service-role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=https://neppacfsixrjzpkvcgxy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YSgMffoDWwjYnjBrYYKTLQ_08Y5BLrz

# Optional direct PostgreSQL connection for private profile/application writes.
# Use a server-only Supabase/Neon connection string, never the publishable key.
DATABASE_URL=

# Set a long random string in production.
AUTH_SECRET=

# Consultant credentials are required for production admin access.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional GitHub OAuth app. Set the callback URL to:
# https://your-domain.example/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
