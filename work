<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FLY YUN - 智能寻访与可视化分析</title>
    <script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --ios-blue: #007AFF;
            --ios-bg: #F2F2F7;
            --ios-card: rgba(255, 255, 255, 0.85);
            --ios-text: #000000;
            --ios-secondary-text: #8E8E93;
            --radius: 20px;
        }

        body { 
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif; 
            background-color: var(--ios-bg); 
            color: var(--ios-text);
            margin: 0;
            -webkit-font-smoothing: antialiased;
        }

        /* --- 登录页面 --- */
        #loginOverlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(180deg, #D1D1D6 0%, #F2F2F7 100%);
            display: flex; justify-content: center; align-items: center;
            z-index: 9999;
        }
        .login-card {
            background: var(--ios-card); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px);
            padding: 40px; border-radius: 40px; width: 320px; text-align: center;
            box-shadow: 0 15px 35px rgba(0,0,0,0.05); border: 1px solid rgba(255,255,255,0.5);
        }

        /* --- 主界面布局 --- */
        .app-container { max-width: 1300px; margin: 0 auto; padding: 40px 20px; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        header h2 { font-size: 34px; font-weight: 800; margin: 0; letter-spacing: -1px; }

        .ios-card {
            background: var(--ios-card); backdrop-filter: blur(10px); border-radius: var(--radius);
            padding: 24px; margin-bottom: 24px; border: 1px solid white;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }

        .section-title { font-size: 18px; font-weight: 700; margin-bottom: 18px; opacity: 0.8; display: flex; align-items: center; gap: 8px; }

        /* --- 可视化看板设计 --- */
        .dashboard-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
        .chart-container { height: 250px; position: relative; }

        /* 表单网格 */
        .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
        .field-group { display: flex; flex-direction: column; }
        .field-group label { font-size: 12px; font-weight: 600; color: var(--ios-secondary-text); margin-bottom: 6px; padding-left: 4px; }
        .grid input, .grid select { background: white; border: 1px solid #D1D1D6; padding: 12px; border-radius: 12px; font-size: 14px; outline: none; }

        /* 按钮组 */
        .actions-bar { display: flex; justify-content: center; gap: 12px; margin: 40px 0; flex-wrap: wrap; }
        .ios-btn { padding: 14px 24px; border-radius: 16px; border: none; font-weight: 600; cursor: pointer; transition: 0.2s; font-size: 15px; display: flex; align-items: center; gap: 6px; }
        .btn-blue { background: var(--ios-blue); color: white; }
        .btn-green { background: #34C759; color: white; }
        .btn-purple { background: #AF52DE; color: white; }
        .btn-gray { background: #E5E5EA; color: #3A3A3C; }

        /* 表格 */
        .table-wrap { overflow-x: auto; border-radius: var(--radius); background: white; }
        table { width: 100%; border-collapse: collapse; min-width: 1800px; }
        th { text-align: left; padding: 18px 12px; font-size: 12px; color: var(--ios-secondary-text); border-bottom: 1px solid #F2F2F7; }
        td { padding: 16px 12px; font-size: 14px; border-bottom: 1px solid #F2F2F7; }
        
        .status-badge { padding: 4px 10px; border-radius: 8px; font-size: 12px; font-weight: 600; }
        .status-合适 { background: #D2F9D8; color: #1E6726; }
        .status-不合适 { background: #FFE5E5; color: #D32F2F; }
        .status-正在联系中 { background: #FFF4D2; color: #8A6D1F; }

        .job-pill { background: white; padding: 6px 12px; border-radius: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); font-size: 12px; display: flex; align-items: center; gap: 5px; }
    </style>
</head>
<body>

<div id="loginOverlay">
    <div class="login-card">
        <h1>FLY YUN</h1>
        <p>输入您的专属访问密码</p>
        <input type="password" id="customPass" style="width:100%; padding:16px; border-radius:14px; border:1px solid #ddd; text-align:center;" placeholder="密码">
        <button class="ios-btn btn-blue" style="width:100%; margin-top:20px; justify-content:center;" onclick="startApp()">进入系统</button>
    </div>
</div>

<div class="app-container" id="appBody" style="display:none">
    <header>
        <h2>FLY YUN</h2>
        <div class="user-tag" id="userDisplay"></div>
    </header>

    <div id="analyticsSection">
        <div class="section-title">📊 寻访分析看板</div>
        <div class="dashboard-grid">
            <div class="ios-card">
                <div style="font-size: 14px; font-weight: 600; margin-bottom: 15px;">人才状态分布</div>
                <div class="chart-container"><canvas id="statusChart"></canvas></div>
            </div>
            <div class="ios-card">
                <div style="font-size: 14px; font-weight: 600; margin-bottom: 15px;">学历背景分布</div>
                <div class="chart-container"><canvas id="eduChart"></canvas></div>
            </div>
            <div class="ios-card">
                <div style="font-size: 14px; font-weight: 600; margin-bottom: 15px;">岗位寻访进展 (Top 5)</div>
                <div class="chart-container"><canvas id="jobChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="ios-card">
        <div class="section-title">💼 岗位库管理</div>
        <div style="display:flex; gap:12px; margin-bottom:15px;">
            <input type="text" id="jobInput" style="padding:10px; border-radius:10px; border:1px solid #ddd; width:250px;" placeholder="新增岗位...">
            <button class="ios-btn btn-blue" style="padding: 10px 20px;" onclick="saveNewJob()">添加</button>
        </div>
        <div id="jobContainer" style="display:flex; flex-wrap:wrap; gap:8px;"></div>
    </div>

    <div class="ios-card">
        <div class="section-title">📝 寻访详情录入</div>
        <div class="grid">
            <div class="field-group"><label>1. 推荐公司</label><input type="text" id="f1"></div>
            <div class="field-group"><label>2. 岗位名称</label><select id="f2"><option value="">请选择...</option></select></div>
            <div class="field-group"><label>3. 姓名</label><input type="text" id="f3"></div>
            <div class="field-group"><label>4. 性别</label><select id="f4"><option value="男">男</option><option value="女">女</option></select></div>
            <div class="field-group"><label>5. 状态</label><select id="f5"><option value="正在联系中">正在联系中</option><option value="合适">合适</option><option value="不合适">不合适</option></select></div>
            <div class="field-group"><label>6. 出生年份</label><select id="f6"></select></div>
            <div class="field-group"><label>7. 岗位产品</label><input type="text" id="f7"></div>
            <div class="field-group"><label>8. 目前所在地</label><input type="text" id="f8"></div>
            <div class="field-group"><label>9. 期望所在地</label><input type="text" id="f9"></div>
            <div class="field-group"><label>10. 现公司</label><input type="text" id="f10"></div>
            <div class="field-group"><label>11. 电话/微信号</label><input type="text" id="f11"></div>
            <div class="field-group"><label>12. 邮箱</label><input type="text" id="f12"></div>
            <div class="field-group"><label>13. 学历</label><select id="f13"><option value="本科">本科</option><option value="研究生">研究生</option><option value="博士">博士</option></select></div>
            <div class="field-group"><label>14. 入学年份</label><input type="text" id="f14"></div>
            <div class="field-group"><label>15. 学校</label><input type="text" id="f15"></div>
            <div class="field-group"><label>16. 备注</label><input type="text" id="f16"></div>
        </div>
    </div>

    <div class="actions-bar">
        <button class="ios-btn btn-blue" onclick="submitData()">✅ 存入名单</button>
        <button class="ios-btn btn-green" onclick="exportExcel()">📊 导出 Excel</button>
        <button class="ios-btn btn-purple" onclick="refreshCharts()">🔄 更新分析图表</button>
        <button class="ios-btn btn-gray" onclick="location.reload()">🔒 退出登录</button>
    </div>

    <div class="ios-card" style="padding:0; overflow:hidden;">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>姓名</th><th>状态</th><th>岗位</th><th>性别</th><th>出生年</th><th>所在地</th><th>现公司</th><th>联系方式</th><th>学历</th><th>学校</th><th>备注</th><th>操作</th></tr>
                </thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    let storageKey = ""; 
    let candidates = [];
    let jobs = [];
    let charts = {}; // 存储图表实例

    function startApp() {
        const pass = document.getElementById('customPass').value;
        if (!pass) return alert("请输入密码");
        storageKey = "FLY_YUN_DASH_" + btoa(pass);
        document.getElementById('loginOverlay').style.display = 'none';
        document.getElementById('appBody').style.display = 'block';
        document.getElementById('userDisplay').innerText = "空间: " + pass;
        
        // 1960-2022 年份初始化
        const yearSel = document.getElementById('f6');
        let yOpt = '<option value="">请选择...</option>';
        for(let y=1960; y<=2022; y++) yOpt += `<option value="${y}">${y}年</option>`;
        yearSel.innerHTML = yOpt;

        loadAllData();
    }

    function loadAllData() {
        candidates = JSON.parse(localStorage.getItem(storageKey) || "[]");
        jobs = JSON.parse(localStorage.getItem(storageKey + "_jobs") || "[]");
        updateJobUI();
        updateTableUI();
        refreshCharts();
    }

    function saveNewJob() {
        const name = document.getElementById('jobInput').value.trim();
        if (name && !jobs.includes(name)) {
            jobs.push(name);
            localStorage.setItem(storageKey + "_jobs", JSON.stringify(jobs));
            document.getElementById('jobInput').value = "";
            updateJobUI();
        }
    }

    function updateJobUI() {
        document.getElementById('jobContainer').innerHTML = jobs.map(j => `<div class="job-pill">${j} <span style="color:red;cursor:pointer" onclick="removeJob('${j}')">×</span></div>`).join('');
        document.getElementById('f2').innerHTML = '<option value="">请选择...</option>' + jobs.map(j => `<option value="${j}">${j}</option>`).join('');
    }

    function removeJob(n) {
        jobs = jobs.filter(j => j !== n);
        localStorage.setItem(storageKey + "_jobs", JSON.stringify(jobs));
        updateJobUI();
    }

    function submitData() {
        const row = {
            id: Date.now(),
            f1: document.getElementById('f1').value, f2: document.getElementById('f2').value,
            f3: document.getElementById('f3').value, f4: document.getElementById('f4').value,
            f5: document.getElementById('f5').value, f6: document.getElementById('f6').value,
            f7: document.getElementById('f7').value, f8: document.getElementById('f8').value,
            f9: document.getElementById('f9').value, f10: document.getElementById('f10').value,
            f11: document.getElementById('f11').value, f12: document.getElementById('f12').value,
            f13: document.getElementById('f13').value, f14: document.getElementById('f14').value,
            f15: document.getElementById('f15').value, f16: document.getElementById('f16').value
        };
        if (!row.f3 || !row.f2) return alert("姓名与岗位为必填");
        candidates.push(row);
        localStorage.setItem(storageKey, JSON.stringify(candidates));
        updateTableUI();
        refreshCharts();
        alert("已录入");
    }

    function updateTableUI() {
        document.getElementById('tableBody').innerHTML = candidates.map(i => `
            <tr>
                <td><strong>${i.f3}</strong></td>
                <td><span class="status-badge status-${i.f5}">${i.f5}</span></td>
                <td>${i.f2}</td><td>${i.f4}</td><td>${i.f6}</td><td>${i.f8}</td>
                <td>${i.f10}</td><td>${i.f11}</td><td>${i.f13}</td><td>${i.f15}</td><td>${i.f16}</td>
                <td><span style="color:#FF3B30;cursor:pointer" onclick="deleteRecord(${i.id})">移除</span></td>
            </tr>
        `).join('');
    }

    function deleteRecord(id) {
        if(confirm("移除该记录？")) {
            candidates = candidates.filter(c => c.id !== id);
            localStorage.setItem(storageKey, JSON.stringify(candidates));
            updateTableUI();
            refreshCharts();
        }
    }

    // --- 核心：可视化逻辑 ---
    function refreshCharts() {
        if (candidates.length === 0) return;

        // 1. 状态分布
        const statusData = { '合适': 0, '不合适': 0, '正在联系中': 0 };
        candidates.forEach(c => statusData[c.f5]++);
        updatePieChart('statusChart', statusData, ['#34C759', '#FF3B30', '#FFCC00']);

        // 2. 学历分布
        const eduData = { '本科': 0, '研究生': 0, '博士': 0 };
        candidates.forEach(c => eduData[c.f13]++);
        updateBarChart('eduChart', eduData, '#007AFF');

        // 3. 岗位分布 Top 5
        const jobCounts = {};
        candidates.forEach(c => jobCounts[c.f2] = (jobCounts[c.f2] || 0) + 1);
        const sortedJobs = Object.entries(jobCounts).sort((a,b) => b[1]-a[1]).slice(0,5);
        updateBarChart('jobChart', Object.fromEntries(sortedJobs), '#AF52DE');
    }

    function updatePieChart(id, dataMap, colors) {
        if (charts[id]) charts[id].destroy();
        charts[id] = new Chart(document.getElementById(id), {
            type: 'doughnut',
            data: {
                labels: Object.keys(dataMap),
                datasets: [{ data: Object.values(dataMap), backgroundColor: colors, borderWidth: 0 }]
            },
            options: { cutout: '70%', plugins: { legend: { position: 'bottom' } } }
        });
    }

    function updateBarChart(id, dataMap, color) {
        if (charts[id]) charts[id].destroy();
        charts[id] = new Chart(document.getElementById(id), {
            type: 'bar',
            data: {
                labels: Object.keys(dataMap),
                datasets: [{ data: Object.values(dataMap), backgroundColor: color, borderRadius: 8 }]
            },
            options: { 
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } },
                plugins: { legend: { display: false } }
            }
        });
    }

    // --- 导出 Excel ---
    function exportExcel() {
        if(candidates.length === 0) return alert("暂无数据");
        const headers = ["推荐公司", "岗位名称", "姓名", "性别", "状态", "出生年", "岗位产品", "目前所在地", "期望所在地", "现公司", "电话/微信", "邮箱", "学历", "入学年份", "学校", "备注"];
        const headerStyle = { fill: { fgColor: { rgb: "4F81BD" } }, font: { color: { rgb: "FFFFFF" }, bold: true } };
        const data = [headers.map(h => ({ v: h, s: headerStyle })), ...candidates.map(i => [i.f1, i.f2, i.f3, i.f4, i.f5, i.f6, i.f7, i.f8, i.f9, i.f10, i.f11, i.f12, i.f13, i.f14, i.f15, i.f16])];
        const ws = XLSX.utils.aoa_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "报告");
        XLSX.writeFile(wb, "FLY_YUN_寻访分析报告.xlsx");
    }
</script>
</body>
</html>
